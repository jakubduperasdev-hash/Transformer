# Copy this file to .env and set your values.
#   Windows: copy env.example .env
#   Linux/Mac: cp env.example .env

# Required in production (use a long random string).
JWT_SECRET=change-me-in-production

# PostgreSQL (local install on D: or elsewhere — use localhost, port 5432).
# Create a database first, e.g. in psql: CREATE DATABASE transformer;
# Then set (replace YOUR_PASSWORD and db name if different):
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/transformer

# Optional: only used when DATABASE_URL is not set (SQLite).
# CHAT_DB_PATH=chat_history.db

# Rate limit: requests per window (default 120 per 60s).
# RATE_LIMIT_REQUESTS=120
# RATE_LIMIT_WINDOW=60

# Optional: Redis for distributed rate limiting (multiple API instances).
# REDIS_URL=redis://localhost:6379/0

# Optional: max tokens per reply (local and external inference). Default 512.
# MAX_REPLY_TOKENS=512

# Optional: external inference (OpenAI-compatible or vLLM/TGI). If set, chat uses this instead of local model.
# INFERENCE_API_URL=https://your-inference.example.com
# INFERENCE_API_KEY=optional-bearer-token
# INFERENCE_MODEL=default
